                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, "E"),
                            mk.kattr(.out, "G"),
                            mk.kattr(.sum, "6..8"),
                            mk.kattr(.values, "O"),
