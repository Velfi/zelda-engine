model_bishopparity :: proc() -> mk.Proc_Node {
    return mk.node(
        mk.Proc_Tag.sequence,
        []mk.Proc_Attr{mk.kattr(.values, "BRGUW")},
        []mk.Proc_Node {
            mk.node(mk.Proc_Tag.one, []mk.Proc_Attr{mk.kattr(.in_, "B"), mk.kattr(.out, "R"), mk.kattr(.steps, 1)}),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "B"),
                    mk.kattr(.out, "G"),
                    mk.kattr(.steps, 1),
                    mk.kattr(.temperature, 10.0),
                },
                []mk.Proc_Node {
                    mk.node(
                        mk.Proc_Tag.field,
                        []mk.Proc_Attr{mk.kattr(.for_, "G"), mk.kattr(.from_, "R"), mk.kattr(.on, "B")},
                    ),
                },
            ),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "BBB/BBB/BBB"),
                    mk.kattr(.out, "***/*U*/***"),
                    mk.kattr(.steps, 1),
                    mk.kattr(.temperature, 10.0),
                },
                []mk.Proc_Node {
                    mk.node(
                        mk.Proc_Tag.field,
                        []mk.Proc_Attr{mk.kattr(.for_, "U"), mk.kattr(.from_, "RG"), mk.kattr(.on, "B")},
                    ),
                },
            ),
            mk.node(
                mk.Proc_Tag.one,
                nil,
                []mk.Proc_Node {
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "R*/*B"), mk.kattr(.out, "W*/*R")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "U*/RB"), mk.kattr(.out, "U*/WR")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "U*/BR"), mk.kattr(.out, "U*/RW")}),
                    mk.node(
                        mk.Proc_Tag.observe,
                        []mk.Proc_Attr{mk.kattr(.value, "G"), mk.kattr(.from_, "B"), mk.kattr(.to, "R")},
                    ),
                    mk.node(mk.Proc_Tag.observe, []mk.Proc_Attr{mk.kattr(.value, "R"), mk.kattr(.to, "W")}),
                    mk.node(mk.Proc_Tag.observe, []mk.Proc_Attr{mk.kattr(.value, "B"), mk.kattr(.to, "BW")}),
                    mk.node(mk.Proc_Tag.observe, []mk.Proc_Attr{mk.kattr(.value, "U"), mk.kattr(.to, "U")}),
                },
            ),
        },
    )
}

