model_hamiltonianpath :: proc() -> mk.Proc_Node {
    return mk.node(
        mk.Proc_Tag.sequence,
        []mk.Proc_Attr{mk.kattr(.values, "BRWGU"), mk.kattr(.origin, true)},
        []mk.Proc_Node {
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr{mk.kattr(.symmetry, "()")},
                []mk.Proc_Node {
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "B/B/R"), mk.kattr(.out, "R/B/B")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "BBR"), mk.kattr(.out, "RBB")}),
                },
            ),
            mk.node(
                mk.Proc_Tag.markov,
                []mk.Proc_Attr{mk.kattr(.symmetry, "(x)")},
                []mk.Proc_Node {
                    mk.node(mk.Proc_Tag.one, []mk.Proc_Attr{mk.kattr(.in_, "RBB"), mk.kattr(.out, "WWR")}),
                    mk.node(mk.Proc_Tag.one, []mk.Proc_Attr{mk.kattr(.in_, "R/B/B"), mk.kattr(.out, "W/W/R")}),
                },
            ),
            mk.node(mk.Proc_Tag.one, []mk.Proc_Attr{mk.kattr(.in_, "BBB/BWB"), mk.kattr(.out, "***/*R*")}),
            mk.node(
                mk.Proc_Tag.markov,
                nil,
                []mk.Proc_Node {
                    mk.node(mk.Proc_Tag.one, []mk.Proc_Attr{mk.kattr(.in_, "UWW"), mk.kattr(.out, "UUU")}),
                    mk.node(
                        mk.Proc_Tag.sequence,
                        nil,
                        []mk.Proc_Node {
                            mk.node(mk.Proc_Tag.one, []mk.Proc_Attr{mk.kattr(.in_, "UWG"), mk.kattr(.out, "RBW")}),
                            mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "U"), mk.kattr(.out, "W")}),
                        },
                    ),
                    mk.node(mk.Proc_Tag.one, []mk.Proc_Attr{mk.kattr(.in_, "RBW"), mk.kattr(.out, "UWG")}),
                },
            ),
        },
    )
}

model_hamiltonianpaths :: proc() -> mk.Proc_Node {
