model_lostcity :: proc() -> mk.Proc_Node {
    return mk.node(
        mk.Proc_Tag.sequence,
        []mk.Proc_Attr{mk.kattr(.values, "BWRDIE")},
        []mk.Proc_Node {
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "B"),
                    mk.kattr(.out, "I"),
                    mk.kattr(.steps, 4),
                    mk.kattr(.comment, "make a few lakes by random growth"),
                },
            ),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr{mk.kattr(.in_, "IB"), mk.kattr(.out, "*I"), mk.kattr(.steps, 24000)},
            ),
            mk.node(
                mk.Proc_Tag.convolution,
                []mk.Proc_Attr{mk.kattr(.neighborhood, "Moore")},
                []mk.Proc_Node {
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, "I"),
                            mk.kattr(.out, "B"),
                            mk.kattr(.sum, "5..8"),
                            mk.kattr(.values, "B"),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, "B"),
                            mk.kattr(.out, "I"),
                            mk.kattr(.sum, "5..8"),
                            mk.kattr(.values, "I"),
                        },
                    ),
                },
            ),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "B"),
                    mk.kattr(.out, "R"),
                    mk.kattr(.steps, 20),
                    mk.kattr(.comment, "make some land by a self-avoiding random walk with backtracking"),
                },
            ),
            mk.node(
                mk.Proc_Tag.markov,
                nil,
                []mk.Proc_Node {
                    mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "RBB"), mk.kattr(.out, "WWR")}),
                    mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "RWW"), mk.kattr(.out, "DDR")}),
                },
            ),
            mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "R"), mk.kattr(.out, "D")}),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "BBWBB"),
                    mk.kattr(.out, "**B**"),
                    mk.kattr(.comment, "erode narrow sections of land"),
                },
            ),
            mk.node(
                mk.Proc_Tag.all,
                nil,
                []mk.Proc_Node {
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "IW"), mk.kattr(.out, "*D")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "I*/*W"), mk.kattr(.out, "**/*D")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "DW"), mk.kattr(.out, "*D")}),
                },
            ),
            mk.node(mk.Proc_Tag.prl, []mk.Proc_Attr{mk.kattr(.in_, "D"), mk.kattr(.out, "B")}),
            mk.node(
                mk.Proc_Tag.prl,
                []mk.Proc_Attr{mk.kattr(.steps, 2)},
                []mk.Proc_Node {
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "WB"), mk.kattr(.out, "*D")}),
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr{mk.kattr(.in_, "DB"), mk.kattr(.out, "*D"), mk.kattr(.p, 0.5)},
                    ),
                },
            ),
            mk.node(
                mk.Proc_Tag.convolution,
                []mk.Proc_Attr{mk.kattr(.neighborhood, "Moore")},
                []mk.Proc_Node {
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, "D"),
                            mk.kattr(.out, "B"),
                            mk.kattr(.sum, "5..8"),
                            mk.kattr(.values, "B"),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, "B"),
                            mk.kattr(.out, "D"),
                            mk.kattr(.sum, "5..8"),
                            mk.kattr(.values, "DI"),
                        },
                    ),
                },
            ),
            mk.node(mk.Proc_Tag.one, []mk.Proc_Attr{mk.kattr(.in_, "BB*/BBB/*B*"), mk.kattr(.out, "***/*E*/***")}),
            mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "*E*/EBE"), mk.kattr(.out, "***/*E*")}),
            mk.node(mk.Proc_Tag.prl, []mk.Proc_Attr{mk.kattr(.in_, "D"), mk.kattr(.out, "B")}),
        },
    )
}

