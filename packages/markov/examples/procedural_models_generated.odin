            mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "***/*P*/***"), mk.kattr(.out, "*Y*/YEY/*Y*")}),
        },
    )
}

model_forest :: proc() -> mk.Proc_Node {
    return mk.node(
        mk.Proc_Tag.sequence,
        []mk.Proc_Attr{mk.kattr(.values, "BIEW")},
        []mk.Proc_Node {
            mk.node(mk.Proc_Tag.one, []mk.Proc_Attr{mk.kattr(.in_, "BB*/BBB/*B*"), mk.kattr(.out, "***/*I*/***")}),
            mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "*I*/IBI"), mk.kattr(.out, "***/*I*")}),
            mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "*B*/BIB/*B*"), mk.kattr(.out, "***/*W*/***")}),
            mk.node(mk.Proc_Tag.one, []mk.Proc_Attr{mk.kattr(.in_, "I"), mk.kattr(.out, "E"), mk.kattr(.steps, 2)}),
            mk.node(
                mk.Proc_Tag.markov,
                nil,
                []mk.Proc_Node {
                    mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "EI"), mk.kattr(.out, "*E")}),
                    mk.node(mk.Proc_Tag.one, []mk.Proc_Attr{mk.kattr(.in_, "EBI/EBI"), mk.kattr(.out, "**E/**E")}),
                },
            ),
            mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "E*W"), mk.kattr(.out, "**E")}),
            mk.node(
                mk.Proc_Tag.prl,
                nil,
                []mk.Proc_Node {
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "I"), mk.kattr(.out, "B")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "W"), mk.kattr(.out, "B")}),
                },
            ),
        },
    )
}

