        },
    )
}

model_hills :: proc() -> mk.Proc_Node {
    return mk.node(
        mk.Proc_Tag.sequence,
        []mk.Proc_Attr{mk.kattr(.values, "BA")},
        []mk.Proc_Node {
            mk.node(mk.Proc_Tag.prl, []mk.Proc_Attr{mk.kattr(.in_, "B"), mk.kattr(.out, "A")}),
            mk.node(
                mk.Proc_Tag.prl,
                []mk.Proc_Attr{mk.kattr(.in_, "A *"), mk.kattr(.out, "B *"), mk.kattr(.symmetry, "()")},
            ),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr{mk.kattr(.in_, "AB"), mk.kattr(.out, "AA"), mk.kattr(.steps, 8000)},
            ),
            mk.node(
                mk.Proc_Tag.convolution,
                []mk.Proc_Attr{mk.kattr(.neighborhood, "NoCorners"), mk.kattr(.periodic, true)},
                []mk.Proc_Node {
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, "B"),
                            mk.kattr(.out, "A"),
                            mk.kattr(.sum, "10..18"),
                            mk.kattr(.values, "A"),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, "A"),
                            mk.kattr(.out, "B"),
                            mk.kattr(.sum, "10..18"),
                            mk.kattr(.values, "B"),
                        },
                    ),
                },
            ),
        },
    )
}

model_irregularmazegrowth :: proc() -> mk.Proc_Node {
    return mk.node(
        mk.Proc_Tag.one,
        []mk.Proc_Attr {
            mk.kattr(.values, "BW"),
            mk.kattr(.origin, true),
            mk.kattr(.in_, "*BB/WBB/*BB"),
            mk.kattr(.out, "***/WW*/***"),
        },
    )
}

model_irregularsaw :: proc() -> mk.Proc_Node {
    return mk.node(
        mk.Proc_Tag.one,
        []mk.Proc_Attr {
            mk.kattr(.values, "BRW"),
            mk.kattr(.origin, true),
            mk.kattr(.in_, "*BB/RBB/*BB"),
            mk.kattr(.out, "***/WR*/***"),
        },
    )
}

model_island :: proc() -> mk.Proc_Node {
    return mk.node(
        mk.Proc_Tag.sequence,
        []mk.Proc_Attr{mk.kattr(.values, "UWBRGEYINSOTus"), mk.kattr(.origin, true)},
        []mk.Proc_Node {
            mk.node(mk.Proc_Tag.prl, []mk.Proc_Attr{mk.kattr(.in_, "***/*U*/***"), mk.kattr(.out, "***/*Y*/***")}),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "WY"),
                    mk.kattr(.out, "WW"),
                    mk.kattr(.steps, 1),
                    mk.kattr(.comment, "draw an island skeleton"),
                },
            ),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "YWY/YYY"),
                    mk.kattr(.out, "YWY/YWY"),
                    mk.kattr(.steps, 400),
                    mk.kattr(.comment, "steps define the lenght of the backbone"),
                },
            ),
            mk.node(mk.Proc_Tag.one, []mk.Proc_Attr{mk.kattr(.in_, "YWY/YWY/YYY"), mk.kattr(.out, "YWY/YRY/YYY")}),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "YYY/WWW"),
                    mk.kattr(.out, "YWY/WWW"),
                    mk.kattr(.steps, 20),
                    mk.kattr(
                        .comment,
                        "adjust steps to change number of branches. More branches = rounder, smoother island with less inner water",
                    ),
                },
            ),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "YWY/YYY"),
                    mk.kattr(.out, "YWY/YWY"),
                    mk.kattr(.steps, 2300),
                    mk.kattr(.comment, "adjust steps for the length of branches. More lenght = bigger island"),
                },
            ),
            mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "R"), mk.kattr(.out, "W")}),
            mk.node(
                mk.Proc_Tag.prl,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "Y"),
                    mk.kattr(.out, "U"),
                    mk.kattr(.p, 0.00003),
                    mk.kattr(.steps, 1),
                    mk.kattr(.comment, "adjust p to reduce lakes"),
                },
            ),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr{mk.kattr(.comment, "Voronoi")},
                []mk.Proc_Node {
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "WY"), mk.kattr(.out, "WW")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "UY"), mk.kattr(.out, "UU")}),
                },
            ),
            mk.node(
                mk.Proc_Tag.convolution,
                []mk.Proc_Attr{mk.kattr(.neighborhood, "Moore"), mk.kattr(.comment, "smoothing")},
                []mk.Proc_Node {
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, "U"),
                            mk.kattr(.out, "W"),
                            mk.kattr(.sum, "5..8"),
                            mk.kattr(.values, "W"),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, "W"),
                            mk.kattr(.out, "U"),
                            mk.kattr(.sum, "5..8"),
                            mk.kattr(.values, "U"),
                        },
                    ),
                },
            ),
            mk.node(
                mk.Proc_Tag.all,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "U/*"),
                    mk.kattr(.out, "I/*"),
                    mk.kattr(.symmetry, "(x)"),
                    mk.kattr(.comment, "paint ocean to find out coasts. Sea will be U, lakes I, deep ocean B"),
                },
            ),
            mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "UI"), mk.kattr(.out, "UU")}),
            mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "WU"), mk.kattr(.out, "WR")}),
            mk.node(
                mk.Proc_Tag.prl,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "RU"),
                    mk.kattr(.out, "RR"),
                    mk.kattr(.steps, 30),
                    mk.kattr(.p, 0.5),
                    mk.kattr(.comment, "steps = size of the shallow water around the coast"),
                },
            ),
            mk.node(mk.Proc_Tag.prl, []mk.Proc_Attr{mk.kattr(.in_, "U"), mk.kattr(.out, "B")}),
            mk.node(mk.Proc_Tag.prl, []mk.Proc_Attr{mk.kattr(.in_, "R"), mk.kattr(.out, "U")}),
            mk.node(
                mk.Proc_Tag.all,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "UW"),
                    mk.kattr(.out, "UG"),
                    mk.kattr(
                        .comment,
                        "spawn a few river sources (paint coast green on some thickness to force sources to be inland)",
                    ),
                },
            ),
            mk.node(
                mk.Proc_Tag.all,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "GW"),
                    mk.kattr(.out, "GG"),
                    mk.kattr(.steps, 80),
                    mk.kattr(.comment, "increase steps to push sources back from the sea"),
                },
            ),
            mk.node(
                mk.Proc_Tag.prl,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "WW"),
                    mk.kattr(.out, "WI"),
                    mk.kattr(.p, 0.000015),
                    mk.kattr(.steps, 1),
                    mk.kattr(.comment, "play with p to change the number of sources"),
                },
            ),
            mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "G"), mk.kattr(.out, "W")}),
            mk.node(
                mk.Proc_Tag.sequence,
                nil,
                []mk.Proc_Node {
                    mk.node(
                        mk.Proc_Tag.one,
                        []mk.Proc_Attr{mk.kattr(.in_, "IW"), mk.kattr(.out, "IR"), mk.kattr(.steps, 1)},
                        []mk.Proc_Node {
                            mk.node(
                                mk.Proc_Tag.field,
                                []mk.Proc_Attr{mk.kattr(.for_, "R"), mk.kattr(.from_, "U"), mk.kattr(.on, "W")},
                            ),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.one,
                        nil,
                        []mk.Proc_Node {
                            mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "RU"), mk.kattr(.out, "NU")}),
                            mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "RO"), mk.kattr(.out, "NO")}),
                            mk.node(
                                mk.Proc_Tag.rule,
                                []mk.Proc_Attr {
                                    mk.kattr(.in_, "NNNRW/WWWWW"),
                                    mk.kattr(.out, "NNWWW/WWNNR"),
                                    mk.kattr(.comment, "break long, straight lines"),
                                },
                            ),
                            mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "RW"), mk.kattr(.out, "NR")}),
                            mk.node(mk.Proc_Tag.observe, []mk.Proc_Attr{mk.kattr(.value, "W"), mk.kattr(.to, "WN")}),
                            mk.node(mk.Proc_Tag.observe, []mk.Proc_Attr{mk.kattr(.value, "R"), mk.kattr(.to, "N")}),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.all,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, "N"),
                            mk.kattr(.out, "O"),
                            mk.kattr(.comment, "color done (O) so that we can merge rivers"),
                        },
                    ),
                    mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "OI"), mk.kattr(.out, "OO")}),
                },
            ),
            mk.node(
                mk.Proc_Tag.prl,
                []mk.Proc_Attr {
                    mk.kattr(.steps, 2),
                    mk.kattr(.p, 0.8),
                    mk.kattr(.comment, "widen the connection with the sea"),
                },
                []mk.Proc_Node {
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "UO/UW"), mk.kattr(.out, "UO/UO")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "UO/WW"), mk.kattr(.out, "UO/OO")}),
                },
            ),
            mk.node(
                mk.Proc_Tag.convolution,
                []mk.Proc_Attr {
                    mk.kattr(.neighborhood, "Moore"),
                    mk.kattr(.periodic, true),
                    mk.kattr(.comment, "smooth"),
                },
                []mk.Proc_Node {
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, "W"),
                            mk.kattr(.out, "O"),
                            mk.kattr(.sum, "6..8"),
                            mk.kattr(.values, "O"),
                        },
                    ),
                },
            ),
            mk.node(
                mk.Proc_Tag.prl,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "WU"),
                    mk.kattr(.out, "YU"),
                    mk.kattr(.steps, 1),
                    mk.kattr(.p, 0.005),
                    mk.kattr(.comment, "generate beaches starting points"),
                },
            ),
            mk.node(
                mk.Proc_Tag.all,
                []mk.Proc_Attr{mk.kattr(.steps, 30), mk.kattr(.comment, "march them along the coast")},
                []mk.Proc_Node {
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "UU/YW"), mk.kattr(.out, "UU/YY")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "UW/YW"), mk.kattr(.out, "UY/YY")}),
                },
            ),
            mk.node(
                mk.Proc_Tag.prl,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "WY"),
                    mk.kattr(.out, "YY"),
                    mk.kattr(.steps, 3),
                    mk.kattr(.p, 0.4),
                    mk.kattr(.comment, "widen them with a bit of randomness"),
                },
            ),
            mk.node(
                mk.Proc_Tag.convolution,
                []mk.Proc_Attr {
                    mk.kattr(.neighborhood, "Moore"),
                    mk.kattr(.periodic, true),
                    mk.kattr(.comment, "smooth them"),
                },
                []mk.Proc_Node {
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, "Y"),
                            mk.kattr(.out, "W"),
                            mk.kattr(.sum, "5..8"),
                            mk.kattr(.values, "W"),
