                []mk.Proc_Node {
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "U/W"), mk.kattr(.out, "W/U")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "W/G"), mk.kattr(.out, "G/W")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "AW"), mk.kattr(.out, "*A")}),
                },
            ),
            mk.node(
                mk.Proc_Tag.all,
                []mk.Proc_Attr{mk.kattr(.in_, "A/W"), mk.kattr(.out, "*/A"), mk.kattr(.symmetry, "()")},
            ),
            mk.node(mk.Proc_Tag.one, []mk.Proc_Attr{mk.kattr(.in_, "W"), mk.kattr(.out, "B"), mk.kattr(.steps, 8)}),
            mk.node(mk.Proc_Tag.one, []mk.Proc_Attr{mk.kattr(.in_, "A"), mk.kattr(.out, "I"), mk.kattr(.steps, 8)}),
            mk.node(mk.Proc_Tag.prl, []mk.Proc_Attr{mk.kattr(.in_, "W"), mk.kattr(.out, "A")}),
            mk.node(
                mk.Proc_Tag.one,
                nil,
                []mk.Proc_Node {
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "BA"), mk.kattr(.out, "BB")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "IA"), mk.kattr(.out, "II")}),
                },
            ),
            mk.node(
                mk.Proc_Tag.one,
                nil,
                []mk.Proc_Node {
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "U**/**I"), mk.kattr(.out, "A**/**S")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "S"), mk.kattr(.out, "U")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "U**/**B"), mk.kattr(.out, "A**/**R")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "R**/**B"), mk.kattr(.out, "W**/**R")}),
                    mk.node(
                        mk.Proc_Tag.observe,
                        []mk.Proc_Attr{mk.kattr(.value, "G"), mk.kattr(.from_, "B"), mk.kattr(.to, "R")},
                    ),
                    mk.node(mk.Proc_Tag.observe, []mk.Proc_Attr{mk.kattr(.value, "U"), mk.kattr(.to, "A")}),
                    mk.node(mk.Proc_Tag.observe, []mk.Proc_Attr{mk.kattr(.value, "B"), mk.kattr(.to, "BW")}),
                    mk.node(mk.Proc_Tag.observe, []mk.Proc_Attr{mk.kattr(.value, "I"), mk.kattr(.to, "IA")}),
                },
            ),
            mk.node(mk.Proc_Tag.one, []mk.Proc_Attr{mk.kattr(.in_, "R"), mk.kattr(.out, "W")}),
        },
    )
}

