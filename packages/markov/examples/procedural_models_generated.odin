                    mk.node(mk.Proc_Tag.prl, []mk.Proc_Attr{mk.kattr(.in_, "V*****v"), mk.kattr(.out, "******n")}),
                    mk.node(mk.Proc_Tag.prl, []mk.Proc_Attr{mk.kattr(.in_, "nBBBBBn"), mk.kattr(.out, "*aaaaa*")}),
                    mk.node(
                        mk.Proc_Tag.prl,
                        nil,
                        []mk.Proc_Node {
                            mk.node(
                                mk.Proc_Tag.rule,
                                []mk.Proc_Attr{mk.kattr(.in_, "a**O**S"), mk.kattr(.out, "***o***")},
                            ),
                            mk.node(
                                mk.Proc_Tag.rule,
                                []mk.Proc_Attr {
                                    mk.kattr(.in_, "V***/****/****/***O"),
                                    mk.kattr(.out, "****/****/****/***o"),
                                },
                            ),
                        },
                    ),
                    mk.node(mk.Proc_Tag.prl, []mk.Proc_Attr{mk.kattr(.in_, "anBBBBBV*"), mk.kattr(.out, "**aaaaa*a")}),
                    mk.node(
                        mk.Proc_Tag.prl,
                        nil,
                        []mk.Proc_Node {
                            mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "a"), mk.kattr(.out, "L")}),
                            mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "n"), mk.kattr(.out, "V")}),
                            mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "v"), mk.kattr(.out, "V")}),
                            mk.node(
                                mk.Proc_Tag.rule,
                                []mk.Proc_Attr{mk.kattr(.in_, "VLLLLLV"), mk.kattr(.out, "***S***")},
                            ),
                            mk.node(
                                mk.Proc_Tag.rule,
                                []mk.Proc_Attr{mk.kattr(.in_, "VBBBBBV"), mk.kattr(.out, "***S***")},
                            ),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.map_,
                        []mk.Proc_Attr{mk.kattr(.scale, "1/3 1/3 1/3"), mk.kattr(.values, "BVSsto yORr CcaGP")},
                        []mk.Proc_Node {
                            mk.node(
                                mk.Proc_Tag.rule,
                                []mk.Proc_Attr {
                                    mk.kattr(.in_, "***/***/*** ***/*O*/*** ***/***/***"),
