                    ),
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, "W"),
                            mk.kattr(.out, "Y"),
                            mk.kattr(.sum, "5..8"),
                            mk.kattr(.values, "Y"),
                        },
                    ),
                },
            ),
            mk.node(
                mk.Proc_Tag.all,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "O"),
                    mk.kattr(.out, "u"),
                    mk.kattr(.comment, "lakes and rivers back to lake blue"),
                },
            ),
            mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "UY"), mk.kattr(.out, "TY")}),
            mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "UW"), mk.kattr(.out, "TW")}),
            mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "uW"), mk.kattr(.out, "TW")}),
            mk.node(
                mk.Proc_Tag.convolution,
                []mk.Proc_Attr{mk.kattr(.neighborhood, "Moore"), mk.kattr(.periodic, true)},
                []mk.Proc_Node {
