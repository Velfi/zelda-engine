            mk.node(
                mk.Proc_Tag.prl,
                []mk.Proc_Attr{mk.kattr(.in_, "S"), mk.kattr(.out, "s"), mk.kattr(.p, 0.0002), mk.kattr(.steps, 1)},
            ),
            mk.node(
                mk.Proc_Tag.one,
                nil,
                []mk.Proc_Node {
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "RS"), mk.kattr(.out, "RR")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "RS"), mk.kattr(.out, "RR")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "RS"), mk.kattr(.out, "RR")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "sS"), mk.kattr(.out, "ss")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "sS"), mk.kattr(.out, "ss")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "sS"), mk.kattr(.out, "ss")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "sS"), mk.kattr(.out, "ss")}),
