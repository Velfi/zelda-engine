model_tetris :: proc() -> mk.Proc_Node {
    return mk.node(
        mk.Proc_Tag.sequence,
        []mk.Proc_Attr{mk.kattr(.values, "CIBWRAO"), mk.kattr(.symmetry, "(x)")},
        []mk.Proc_Node {
            mk.node(mk.Proc_Tag.union_, []mk.Proc_Attr{mk.kattr(.symbol, "?"), mk.kattr(.values, "ICB")}),
            mk.node(mk.Proc_Tag.prl, []mk.Proc_Attr{mk.kattr(.in_, "*/C"), mk.kattr(.out, "*/I")}),
            mk.node(mk.Proc_Tag.prl, []mk.Proc_Attr{mk.kattr(.in_, "*/*/*/*/I"), mk.kattr(.out, "*/*/*/*/W")}),
            mk.node(mk.Proc_Tag.prl, []mk.Proc_Attr{mk.kattr(.in_, "W/*"), mk.kattr(.out, "B/*")}),
            mk.node(
                mk.Proc_Tag.markov,
                nil,
                []mk.Proc_Node {
                    mk.node(mk.Proc_Tag.one, []mk.Proc_Attr{mk.kattr(.in_, "IB"), mk.kattr(.out, "*I")}),
                    mk.node(
                        mk.Proc_Tag.one,
                        []mk.Proc_Attr{mk.kattr(.in_, "AR"), mk.kattr(.out, "AA"), mk.kattr(.symmetry, "(xy)")},
                    ),
                    mk.node(mk.Proc_Tag.one, []mk.Proc_Attr{mk.kattr(.in_, "R/W"), mk.kattr(.out, "A/W")}),
                    mk.node(
                        mk.Proc_Tag.prl,
                        nil,
                        []mk.Proc_Node {
                            mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "R/B"), mk.kattr(.out, "*/R")}),
                            mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "R/I"), mk.kattr(.out, "*/R")}),
                            mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "?/R"), mk.kattr(.out, "*/B")}),
                        },
                    ),
                    mk.node(mk.Proc_Tag.one, []mk.Proc_Attr{mk.kattr(.in_, "A"), mk.kattr(.out, "W")}),
                    mk.node(
                        mk.Proc_Tag.one,
                        []mk.Proc_Attr{mk.kattr(.symmetry, "(xy)")},
                        []mk.Proc_Node {
                            mk.node(
                                mk.Proc_Tag.rule,
                                []mk.Proc_Attr{mk.kattr(.in_, "III/III"), mk.kattr(.out, "*R*/RRR")},
                            ),
                            mk.node(
                                mk.Proc_Tag.rule,
                                []mk.Proc_Attr{mk.kattr(.in_, "III/III"), mk.kattr(.out, "RR*/*RR")},
                            ),
                            mk.node(
                                mk.Proc_Tag.rule,
                                []mk.Proc_Attr{mk.kattr(.in_, "III/III"), mk.kattr(.out, "R**/RRR")},
                            ),
                            mk.node(
                                mk.Proc_Tag.rule,
                                []mk.Proc_Attr{mk.kattr(.in_, "III/III"), mk.kattr(.out, "RR*/RR*")},
                            ),
                        },
                    ),
                },
            ),
            mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "WI"), mk.kattr(.out, "O*")}),
            mk.node(
                mk.Proc_Tag.all,
                []mk.Proc_Attr{mk.kattr(.symmetry, "(xy)")},
                []mk.Proc_Node {
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "O*"), mk.kattr(.out, "OO")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "OO"), mk.kattr(.out, "BB")}),
                },
            ),
        },
    )
}

model_texture :: proc() -> mk.Proc_Node {
    return mk.node(
        mk.Proc_Tag.sequence,
        []mk.Proc_Attr{mk.kattr(.values, "BIURW")},
        []mk.Proc_Node {
            mk.node(mk.Proc_Tag.one, []mk.Proc_Attr{mk.kattr(.in_, "BB*/BBB/*B*"), mk.kattr(.out, "***/*I*/***")}),
            mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "*I*/IBI"), mk.kattr(.out, "***/*I*")}),
            mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "*B*/BIB/*B*"), mk.kattr(.out, "***/*W*/***")}),
            mk.node(
                mk.Proc_Tag.markov,
                nil,
                []mk.Proc_Node {
                    mk.node(
                        mk.Proc_Tag.all,
                        nil,
                        []mk.Proc_Node {
                            mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "UI"), mk.kattr(.out, "*U")}),
                            mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "RI"), mk.kattr(.out, "*R")}),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.one,
                        nil,
                        []mk.Proc_Node {
                            mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "I"), mk.kattr(.out, "U")}),
                            mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "I"), mk.kattr(.out, "R")}),
                        },
                    ),
                },
            ),
        },
    )
}

model_tiledungeon :: proc() -> mk.Proc_Node {
    return mk.node(
        mk.Proc_Tag.sequence,
        []mk.Proc_Attr{mk.kattr(.values, "PB")},
        []mk.Proc_Node {
            mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "***/*P*/***"), mk.kattr(.out, "***/*B*/***")}),
            mk.node(
                mk.Proc_Tag.wfc,
                []mk.Proc_Attr{mk.kattr(.tileset, "Dungeon"), mk.kattr(.values, "ABW")},
                []mk.Proc_Node {
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "P"), mk.kattr(.out, "Stone")}),
                    mk.node(
                        mk.Proc_Tag.markov,
                        nil,
                        []mk.Proc_Node {
                            mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "WA"), mk.kattr(.out, "*W")}),
                            mk.node(
                                mk.Proc_Tag.path,
                                []mk.Proc_Attr {
                                    mk.kattr(.from_, "A"),
                                    mk.kattr(.to, "W"),
                                    mk.kattr(.on, "B"),
                                    mk.kattr(.color, "W"),
                                },
                            ),
                            mk.node(mk.Proc_Tag.one, []mk.Proc_Attr{mk.kattr(.in_, "A"), mk.kattr(.out, "W")}),
                        },
                    ),
                },
            ),
        },
    )
}

model_tilepath :: proc() -> mk.Proc_Node {
    return mk.node(
        mk.Proc_Tag.sequence,
        []mk.Proc_Attr{mk.kattr(.values, "BAR")},
        []mk.Proc_Node {
            mk.node(
                mk.Proc_Tag.all,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "***/*B*/***"),
                    mk.kattr(.out, "***/*A*/***"),
                    mk.kattr(.comment, "color all inner cells gray"),
                },
            ),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "BBB/BAA/BAA"),
                    mk.kattr(.out, "***/***/**R"),
                    mk.kattr(.symmetry, "()"),
                    mk.kattr(.comment, "color 2 cells near opposite corners red"),
                },
            ),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "AAB/AAB/BBB"),
                    mk.kattr(.out, "R**/***/***"),
                    mk.kattr(.symmetry, "()"),
                },
            ),
            mk.node(
                mk.Proc_Tag.wfc,
                []mk.Proc_Attr{mk.kattr(.tileset, "Knots2D"), mk.kattr(.values, "EUIR")},
                []mk.Proc_Node {
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "B"), mk.kattr(.out, "Empty")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "A"), mk.kattr(.out, "Empty|Line|Turn")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "R"), mk.kattr(.out, "End")}),
                    mk.node(
                        mk.Proc_Tag.one,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, "EEE/EUE"),
                            mk.kattr(.out, "***/*I*"),
                            mk.kattr(.comment, "color river endpoints indigo"),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.all,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, "IU"),
                            mk.kattr(.out, "*I"),
                            mk.kattr(.comment, "color the whole path indigo"),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.one,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, "EEE/EIE"),
                            mk.kattr(.out, "***/*R*"),
                            mk.kattr(.comment, "color endpoints red"),
                        },
                    ),
                },
            ),
        },
    )
}

model_trail :: proc() -> mk.Proc_Node {
    return mk.node(
        mk.Proc_Tag.one,
        []mk.Proc_Attr{mk.kattr(.values, "BRW"), mk.kattr(.origin, true)},
        []mk.Proc_Node {
            mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "RB"), mk.kattr(.out, "WR")}),
            mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "RW"), mk.kattr(.out, "WR")}),
        },
    )
}

model_voronoi :: proc() -> mk.Proc_Node {
    return mk.node(
        mk.Proc_Tag.sequence,
        []mk.Proc_Attr{mk.kattr(.values, "BYE")},
        []mk.Proc_Node {
            mk.node(mk.Proc_Tag.one, []mk.Proc_Attr{mk.kattr(.in_, "B"), mk.kattr(.out, "E"), mk.kattr(.steps, 10)}),
            mk.node(mk.Proc_Tag.one, []mk.Proc_Attr{mk.kattr(.in_, "B"), mk.kattr(.out, "Y"), mk.kattr(.steps, 10)}),
            mk.node(
                mk.Proc_Tag.all,
                nil,
                []mk.Proc_Node {
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "EB"), mk.kattr(.out, "*E")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "YB"), mk.kattr(.out, "*Y")}),
                },
