                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, "u"),
                            mk.kattr(.out, "T"),
                            mk.kattr(.sum, "5..8"),
                            mk.kattr(.values, "T"),
                        },
