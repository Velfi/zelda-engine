                            mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "RE"), mk.kattr(.out, "NR")}),
                            mk.node(mk.Proc_Tag.observe, []mk.Proc_Attr{mk.kattr(.value, "E"), mk.kattr(.to, "EN")}),
                            mk.node(mk.Proc_Tag.observe, []mk.Proc_Attr{mk.kattr(.value, "R"), mk.kattr(.to, "N")}),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.one,
                        []mk.Proc_Attr{mk.kattr(.in_, "NS"), mk.kattr(.out, "RN"), mk.kattr(.steps, 5)},
                    ),
                    mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "R"), mk.kattr(.out, "T")}),
