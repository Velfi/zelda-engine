            mk.node(
                mk.Proc_Tag.all,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "W"),
                    mk.kattr(.out, "G"),
                    mk.kattr(
                        .comment,
                        "if any white, it's grass (islands). TODO: Eliminate islands next to lakes or islands too small",
                    ),
                },
            ),
            mk.node(
                mk.Proc_Tag.all,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "B"),
                    mk.kattr(.out, "I"),
                    mk.kattr(.comment, "change deep ocean color"),
