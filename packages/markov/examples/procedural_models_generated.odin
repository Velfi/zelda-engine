model_nystromdungeon :: proc() -> mk.Proc_Node {
    return mk.node(
        mk.Proc_Tag.sequence,
        []mk.Proc_Attr{mk.kattr(.values, "BPWRG"), mk.kattr(.origin, true)},
        []mk.Proc_Node {
            mk.node(
                mk.Proc_Tag.all,
                []mk.Proc_Attr{mk.kattr(.in_, "PBB"), mk.kattr(.out, "**P"), mk.kattr(.comment, "draw a grid")},
            ),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "PBPBPBPBP/BBBBBBBBB/PBPBPBPBP/BBBBBBBBB/PBPBPBPBP/BBBBBBBBB/PBPBPBPBP"),
                    mk.kattr(.out, "WWWWWWWWW/WWWWWWWWW/WWWWWWWWW/WWWWWWWWW/WWWWWWWWW/WWWWWWWWW/WWWWWWWWW"),
                },
            ),
            mk.node(
                mk.Proc_Tag.markov,
                []mk.Proc_Attr{mk.kattr(.comment, "generate corridors with MazeBacktracker")},
                []mk.Proc_Node {
                    mk.node(mk.Proc_Tag.one, []mk.Proc_Attr{mk.kattr(.in_, "RBP"), mk.kattr(.out, "GGR")}),
                    mk.node(mk.Proc_Tag.one, []mk.Proc_Attr{mk.kattr(.in_, "GGR"), mk.kattr(.out, "RWW")}),
                    mk.node(mk.Proc_Tag.one, []mk.Proc_Attr{mk.kattr(.in_, "P"), mk.kattr(.out, "R")}),
                },
            ),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "R"),
                    mk.kattr(.out, "G"),
                    mk.kattr(.steps, 1),
                    mk.kattr(.comment, "leave only one start"),
                },
            ),
            mk.node(
                mk.Proc_Tag.all,
                []mk.Proc_Attr{mk.kattr(.in_, "R"), mk.kattr(.out, "W"), mk.kattr(.comment, "forget other starts")},
            ),
            mk.node(
                mk.Proc_Tag.markov,
                []mk.Proc_Attr{mk.kattr(.comment, "connect components")},
                []mk.Proc_Node {
                    mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "GWW"), mk.kattr(.out, "**G")}),
                    mk.node(mk.Proc_Tag.one, []mk.Proc_Attr{mk.kattr(.in_, "GBW"), mk.kattr(.out, "*WG")}),
                },
            ),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "GBG"),
                    mk.kattr(.out, "*W*"),
                    mk.kattr(.steps, 5),
                    mk.kattr(.comment, "insert cycles"),
                },
            ),
            mk.node(
                mk.Proc_Tag.all,
                []mk.Proc_Attr{mk.kattr(.in_, "G"), mk.kattr(.out, "W"), mk.kattr(.comment, "forget structure")},
            ),
            mk.node(
                mk.Proc_Tag.all,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "BBB/BWB"),
                    mk.kattr(.out, "BBB/BBB"),
                    mk.kattr(.comment, "retract dead ends"),
                },
            ),
        },
    )
}

