model_multiheadeddungeon :: proc() -> mk.Proc_Node {
    return mk.node(
        mk.Proc_Tag.sequence,
        []mk.Proc_Attr{mk.kattr(.values, "BRWGO"), mk.kattr(.origin, true)},
        []mk.Proc_Node {
            mk.node(
                mk.Proc_Tag.markov,
                nil,
                []mk.Proc_Node {
                    mk.node(
                        mk.Proc_Tag.sequence,
                        nil,
                        []mk.Proc_Node {
                            mk.node(
                                mk.Proc_Tag.one,
                                []mk.Proc_Attr{mk.kattr(.in_, "R***B"), mk.kattr(.out, "*WWWG"), mk.kattr(.steps, 3)},
                            ),
                            mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "R"), mk.kattr(.out, "O")}),
                            mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "G"), mk.kattr(.out, "R")}),
                        },
                    ),
                },
            ),
            mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "BBB/BOB"), mk.kattr(.out, "***/*R*")}),
            mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "RBBBR"), mk.kattr(.out, "OWWWO")}),
            mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "R"), mk.kattr(.out, "O")}),
            mk.node(
                mk.Proc_Tag.all,
                []mk.Proc_Attr{mk.kattr(.in_, "BBBBB/BOWWW/BBBBB"), mk.kattr(.out, "*****/*BBBB/*****")},
            ),
            mk.node(
                mk.Proc_Tag.all,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "OWWWO/W***W/W***W/W***W/OBBBO"),
                    mk.kattr(.out, "*****/*****/*****/*****/*WWW*"),
                },
            ),
            mk.node(
                mk.Proc_Tag.all,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "*******/*OWWWO*/*W***W*/*W*B*W*/*W***W*/*OWWWO*/*******"),
                    mk.kattr(.out, "WWWWWWW/W*****W/W*WWW*W/W*WGW*W/W*WWW*W/W*****W/WWWWWWW"),
                },
            ),
            mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "O"), mk.kattr(.out, "W")}),
            mk.node(
                mk.Proc_Tag.prl,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "GWWWG/WWWWW/WWWWW/WWWWW/GWWWG"),
                    mk.kattr(.out, "BBBBB/BBBBB/BBBBB/BBBBB/BBBBB"),
                },
            ),
            mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "G"), mk.kattr(.out, "W")}),
        },
    )
}

model_multiheadedwalk :: proc() -> mk.Proc_Node {
    return mk.node(
        mk.Proc_Tag.sequence,
