                },
            ),
            mk.node(
                mk.Proc_Tag.prl,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "UTW"),
                    mk.kattr(.out, "UTG"),
                    mk.kattr(.p, 0.1),
                    mk.kattr(.steps, 1),
                    mk.kattr(.comment, "seed forests and plains"),
                },
            ),
            mk.node(
                mk.Proc_Tag.prl,
                []mk.Proc_Attr{mk.kattr(.in_, "YW"), mk.kattr(.out, "YG"), mk.kattr(.p, 1), mk.kattr(.steps, 1)},
            ),
            mk.node(
                mk.Proc_Tag.prl,
                []mk.Proc_Attr{mk.kattr(.in_, "WTW"), mk.kattr(.out, "WTE"), mk.kattr(.p, 0.05), mk.kattr(.steps, 1)},
            ),
            mk.node(
                mk.Proc_Tag.prl,
                []mk.Proc_Attr{mk.kattr(.in_, "W"), mk.kattr(.out, "G"), mk.kattr(.p, 0.00001), mk.kattr(.steps, 1)},
            ),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr{mk.kattr(.comment, "grow them, forest 3x stronger")},
                []mk.Proc_Node {
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "WE"), mk.kattr(.out, "EE")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "WE"), mk.kattr(.out, "EE")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "WE"), mk.kattr(.out, "EE")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "WG"), mk.kattr(.out, "GG")}),
                },
            ),
            mk.node(
                mk.Proc_Tag.convolution,
                []mk.Proc_Attr{mk.kattr(.neighborhood, "Moore"), mk.kattr(.periodic, true)},
                []mk.Proc_Node {
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, "G"),
                            mk.kattr(.out, "E"),
                            mk.kattr(.sum, "5..8"),
                            mk.kattr(.values, "E"),
