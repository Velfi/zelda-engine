                                []mk.Proc_Attr{mk.kattr(.in_, "UUU/UUU/UPU"), mk.kattr(.out, "***/*P*/*E*")},
                            ),
                            mk.node(
                                mk.Proc_Tag.rule,
                                []mk.Proc_Attr {
                                    mk.kattr(.in_, "UUU/UUU/UUU/PUU/**U"),
                                    mk.kattr(.out, "***/*P*/*E*/EE*/***"),
                                },
                            ),
                            mk.node(
