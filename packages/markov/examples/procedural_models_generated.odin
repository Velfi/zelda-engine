model_stairspath :: proc() -> mk.Proc_Node {
    return mk.node(
        mk.Proc_Tag.sequence,
        []mk.Proc_Attr{mk.kattr(.values, "BDROAGE"), mk.kattr(.origin, true), mk.kattr(.symmetry, "(xy)")},
        []mk.Proc_Node {
            mk.node(
                mk.Proc_Tag.all,
                []mk.Proc_Attr{mk.kattr(.in_, "D**B"), mk.kattr(.out, "***D"), mk.kattr(.symmetry, "(xyz)")},
            ),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "DBBDBBD"),
                    mk.kattr(.out, "B**GEBB"),
                    mk.kattr(.steps, 1),
                    mk.kattr(.comment, "finish"),
                },
            ),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "DBBDBBD"),
                    mk.kattr(.out, "RO*****"),
                    mk.kattr(.steps, 1),
                    mk.kattr(.comment, "start"),
                },
            ),
            mk.node(mk.Proc_Tag.prl, []mk.Proc_Attr{mk.kattr(.in_, "D"), mk.kattr(.out, "B")}),
            mk.node(
                mk.Proc_Tag.one,
                nil,
                []mk.Proc_Node {
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, "ROBBB"),
                            mk.kattr(.out, "DAARO"),
                            mk.kattr(.comment, "forward"),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, "ROBB/*BBB/***B/***B"),
                            mk.kattr(.out, "DAAR/*BBO/****/****"),
                            mk.kattr(.comment, "Turn"),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, "ROBBB BBBBB BBBBB BBBBB"),
                            mk.kattr(.out, "DAADB BBBAB BBBAB DBBRO"),
                            mk.kattr(.comment, "stairs down"),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, "BBBBB BBBBB BBBBB ROBBB"),
                            mk.kattr(.out, "DBBRO BBBAB BBBAB DAADB"),
                            mk.kattr(.comment, "stairs up"),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.observe,
                        []mk.Proc_Attr{mk.kattr(.value, "G"), mk.kattr(.from_, "B"), mk.kattr(.to, "R")},
                    ),
                    mk.node(
                        mk.Proc_Tag.observe,
                        []mk.Proc_Attr{mk.kattr(.value, "E"), mk.kattr(.from_, "B"), mk.kattr(.to, "O")},
                    ),
                    mk.node(mk.Proc_Tag.observe, []mk.Proc_Attr{mk.kattr(.value, "R"), mk.kattr(.to, "D")}),
                    mk.node(mk.Proc_Tag.observe, []mk.Proc_Attr{mk.kattr(.value, "O"), mk.kattr(.to, "A")}),
                    mk.node(mk.Proc_Tag.observe, []mk.Proc_Attr{mk.kattr(.value, "B"), mk.kattr(.to, "BDA")}),
                },
            ),
            mk.node(mk.Proc_Tag.one, []mk.Proc_Attr{mk.kattr(.in_, "ROBB"), mk.kattr(.out, "DAAD")}),
            mk.node(
                mk.Proc_Tag.map_,
                []mk.Proc_Attr {
                    mk.kattr(.scale, "5/3 5/3 5/3"),
                    mk.kattr(.values, "BWAR"),
                    mk.kattr(.folder, "Stairs"),
                },
                []mk.Proc_Node {
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, "BBB/BBB/BBB BBB/ADA/BBB BBB/BBB/BBB"),
                            mk.kattr(.fout, "Line"),
                            mk.kattr(.legend, "BAW"),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, "BBB/BBB/BBB BBB/BDA/BAB BBB/BBB/BBB"),
                            mk.kattr(.fout, "Turn"),
                            mk.kattr(.legend, "BAW"),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, "BBB/BBB/BBB BBB/ADB/BBB BBB/BAB/BBB"),
                            mk.kattr(.fout, "Down"),
                            mk.kattr(.legend, "BAW"),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, "BBB/BAB/BBB BBB/BDA/BBB BBB/BBB/BBB"),
                            mk.kattr(.fout, "Up"),
                            mk.kattr(.legend, "BAW"),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, "BBB/BBB/BBB BBB/ADB/BBB BBB/BBB/BBB"),
                            mk.kattr(.fout, "End"),
                            mk.kattr(.legend, "BAWR"),
                        },
                    ),
                },
            ),
        },
    )
}

