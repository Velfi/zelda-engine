                                []mk.Proc_Attr {
                                    mk.kattr(.in_, "UUUUU/UUUUU/UUUUU/UUPUU/U***U"),
                                    mk.kattr(.out, "*****/*P*P*/*E*E*/*EEE*/*****"),
                                },
                            ),
                            mk.node(
                                mk.Proc_Tag.rule,
                                []mk.Proc_Attr{mk.kattr(.in_, "UUU/UPU/UEU/UEU"), mk.kattr(.out, "*Y*/YEY/*Y*/***")},
                            ),
