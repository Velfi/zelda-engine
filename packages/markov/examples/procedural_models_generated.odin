    )
}

model_wavebrickwall :: proc() -> mk.Proc_Node {
    return mk.node(
        mk.Proc_Tag.sequence,
        []mk.Proc_Attr{mk.kattr(.values, "B"), mk.kattr(.symmetry, "()")},
        []mk.Proc_Node {
            mk.node(
                mk.Proc_Tag.wfc,
                []mk.Proc_Attr {
                    mk.kattr(.sample, "BrickWall"),
                    mk.kattr(.values, "bNn"),
                    mk.kattr(.n, 3),
                    mk.kattr(.periodic, true),
                    mk.kattr(.shannon, true),
                },
                []mk.Proc_Node {
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "B"), mk.kattr(.out, "b|N|n")}),
                },
            ),
        },
    )
}

model_wavedungeon :: proc() -> mk.Proc_Node {
    return mk.node(
        mk.Proc_Tag.sequence,
        []mk.Proc_Attr{mk.kattr(.values, "BWDG")},
        []mk.Proc_Node {
            mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "***/*B*/***"), mk.kattr(.out, "***/*D*/***")}),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(.in_, "DDDD/DDDD/DDDD"),
                    mk.kattr(.out, "WWWW/WWWW/WWWW"),
                    mk.kattr(.steps, 5),
                },
            ),
            mk.node(
                mk.Proc_Tag.markov,
                nil,
                []mk.Proc_Node {
                    mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "GW"), mk.kattr(.out, "*G")}),
                    mk.node(
                        mk.Proc_Tag.path,
                        []mk.Proc_Attr {
                            mk.kattr(.from_, "G"),
                            mk.kattr(.to, "W"),
                            mk.kattr(.on, "D"),
                            mk.kattr(.color, "W"),
                            mk.kattr(.inertia, true),
                        },
                    ),
                    mk.node(mk.Proc_Tag.one, []mk.Proc_Attr{mk.kattr(.in_, "W"), mk.kattr(.out, "G")}),
                },
            ),
            mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "G"), mk.kattr(.out, "W")}),
            mk.node(
                mk.Proc_Tag.wfc,
                []mk.Proc_Attr{mk.kattr(.sample, "Dungeon"), mk.kattr(.values, "BWP"), mk.kattr(.n, 3)},
                []mk.Proc_Node {
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "B"), mk.kattr(.out, "B")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "W"), mk.kattr(.out, "W")}),
                    mk.node(
                        mk.Proc_Tag.one,
                        []mk.Proc_Attr{mk.kattr(.in_, "W"), mk.kattr(.out, "P"), mk.kattr(.steps, 1)},
                    ),
                    mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "PW"), mk.kattr(.out, "*P")}),
                    mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "W"), mk.kattr(.out, "B")}),
                },
            ),
        },
    )
}

model_waveflowers :: proc() -> mk.Proc_Node {
    return mk.node(
        mk.Proc_Tag.sequence,
        []mk.Proc_Attr{mk.kattr(.values, "BW"), mk.kattr(.symmetry, "(x)")},
        []mk.Proc_Node {
            mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "B/*/*"), mk.kattr(.out, "W/*/*")}),
            mk.node(
                mk.Proc_Tag.wfc,
                []mk.Proc_Attr {
                    mk.kattr(.sample, "Flowers"),
                    mk.kattr(.values, "zYgN"),
                    mk.kattr(.n, 3),
                    mk.kattr(.periodic, true),
                    mk.kattr(.shannon, true),
                },
                []mk.Proc_Node {
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "B"), mk.kattr(.out, "N|g")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "W"), mk.kattr(.out, "z|g|Y")}),
                },
            ),
        },
    )
}

model_wilson :: proc() -> mk.Proc_Node {
    return mk.node(
        mk.Proc_Tag.sequence,
        []mk.Proc_Attr{mk.kattr(.values, "BWIRKGYU"), mk.kattr(.origin, true)},
        []mk.Proc_Node {
            mk.node(
                mk.Proc_Tag.all,
                nil,
                []mk.Proc_Node {
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "WBB"), mk.kattr(.out, "**I")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "IBB"), mk.kattr(.out, "**I")}),
                },
            ),
            mk.node(
                mk.Proc_Tag.markov,
                nil,
                []mk.Proc_Node {
                    mk.node(
                        mk.Proc_Tag.one,
                        nil,
                        []mk.Proc_Node {
                            mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "RBI"), mk.kattr(.out, "KKR")}),
                            mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "RBK"), mk.kattr(.out, "GKY")}),
                            mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "RBW"), mk.kattr(.out, "WWW")}),
                            mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "WKK"), mk.kattr(.out, "WWW")}),
                            mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "YKG"), mk.kattr(.out, "YBU")}),
                            mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "UKK"), mk.kattr(.out, "IBU")}),
                            mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "UKY"), mk.kattr(.out, "IBR")}),
                        },
                    ),
                    mk.node(mk.Proc_Tag.one, []mk.Proc_Attr{mk.kattr(.in_, "I"), mk.kattr(.out, "R")}),
                },
            ),
        },
    )
}

model_wolfbasedapproach :: proc() -> mk.Proc_Node {
    return mk.node(
        mk.Proc_Tag.sequence,
        []mk.Proc_Attr{mk.kattr(.values, "DEIWRSA")},
        []mk.Proc_Node {
            mk.node(mk.Proc_Tag.prl, []mk.Proc_Attr{mk.kattr(.in_, "***/*D*/***"), mk.kattr(.out, "***/*E*/***")}),
            mk.node(mk.Proc_Tag.one, []mk.Proc_Attr{mk.kattr(.in_, "E"), mk.kattr(.out, "W"), mk.kattr(.steps, 15)}),
            mk.node(mk.Proc_Tag.one, []mk.Proc_Attr{mk.kattr(.in_, "E"), mk.kattr(.out, "R"), mk.kattr(.steps, 1)}),
            mk.node(
                mk.Proc_Tag.all,
                nil,
                []mk.Proc_Node {
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "RI"), mk.kattr(.out, "IR")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "RE"), mk.kattr(.out, "SR")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "WI"), mk.kattr(.out, "IW")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "WE"), mk.kattr(.out, "IW")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "RW"), mk.kattr(.out, "RR")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "R*/*W"), mk.kattr(.out, "R*/*R")}),
                    mk.node(
                        mk.Proc_Tag.field,
                        []mk.Proc_Attr {
                            mk.kattr(.for_, "W"),
                            mk.kattr(.to, "E"),
                            mk.kattr(.on, "I"),
                            mk.kattr(.recompute, true),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.field,
                        []mk.Proc_Attr {
                            mk.kattr(.for_, "R"),
                            mk.kattr(.to, "W"),
                            mk.kattr(.on, "EI"),
                            mk.kattr(.recompute, true),
                            mk.kattr(.essential, true),
                        },
                    ),
                },
            ),
            mk.node(
                mk.Proc_Tag.prl,
                nil,
                []mk.Proc_Node {
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "E"), mk.kattr(.out, "D")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "S"), mk.kattr(.out, "A")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "R"), mk.kattr(.out, "A")}),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "I"), mk.kattr(.out, "A")}),
                },
            ),
            mk.node(
                mk.Proc_Tag.all,
                nil,
                []mk.Proc_Node {
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, "DA/AD"), mk.kattr(.out, "**/*A")}),
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr{mk.kattr(.in_, "AAA/ADA/AAA"), mk.kattr(.out, "***/*A*/***")},
                    ),
                },
            ),
            mk.node(mk.Proc_Tag.all, []mk.Proc_Attr{mk.kattr(.in_, "DDD/DAD"), mk.kattr(.out, "***/*D*")}),
        },
    )
}

