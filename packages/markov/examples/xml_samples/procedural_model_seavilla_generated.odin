                            [][]int{[]int{mk.OUT_KEEP, mk.OUT_KEEP, 1}},
                        ),
                    ),
                ),
                mk.prl(
                    mk.kattr(.comment, "final colors"),
                    mk.rule(mk.in_exact_layer([]int{19}), mk.out_exact_layer([]int{7})),
                    mk.rule(mk.in_exact_layer([]int{18}), mk.out_exact_layer([]int{1})),
                    mk.rule(mk.in_exact_layer([]int{17}), mk.out_exact_layer([]int{1})),
                    mk.rule(mk.in_exact_layer([]int{28}), mk.out_exact_layer([]int{1})),
                    mk.rule(mk.in_exact_layer([]int{27}), mk.out_exact_layer([]int{1})),
                ),
            ),
        ),
    )
}
