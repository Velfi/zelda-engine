                            mk.write_row(mk.keep(), mk.keep(), mk.sym(2)),
                        ),
                    ),
                    mk.kattr(.symmetry, mk.symmetry_mask(mk.SYMMETRY_2D_IDENTITY)),
                    mk.kattr(.comment, "color 2 cells near opposite corners red"),
                },
