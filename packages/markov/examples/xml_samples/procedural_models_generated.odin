model_hamiltonianpath :: proc() -> mk.Proc_Node {
    return mk.node(
        mk.Proc_Tag.sequence,
        []mk.Proc_Attr{mk.kattr(.values, mk.values_count(5)), mk.kattr(.origin, true)},
        []mk.Proc_Node {
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr{mk.kattr(.symmetry, mk.symmetry_mask(mk.SYMMETRY_2D_IDENTITY))},
                []mk.Proc_Node {
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(
                                .in_,
                                mk.match_layer_enum(
                                    []Generated_Symbol{.s0},
                                    []Generated_Symbol{.s0},
                                    []Generated_Symbol{.s1},
                                ),
                            ),
                            mk.kattr(
                                .out,
                                mk.write_layer_enum(
                                    []Generated_Symbol{.s1},
                                    []Generated_Symbol{.s0},
                                    []Generated_Symbol{.s0},
                                ),
                            ),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s0, .s0, .s1})),
                            mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s1, .s0, .s0})),
                        },
                    ),
                },
            ),
            mk.node(
                mk.Proc_Tag.markov,
                []mk.Proc_Attr{mk.kattr(.symmetry, mk.symmetry_mask(mk.SYMMETRY_2D_X))},
                []mk.Proc_Node {
                    mk.node(
                        mk.Proc_Tag.one,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s1, .s0, .s0})),
                            mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s2, .s2, .s1})),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.one,
                        []mk.Proc_Attr {
                            mk.kattr(
                                .in_,
                                mk.match_layer_enum(
                                    []Generated_Symbol{.s1},
                                    []Generated_Symbol{.s0},
                                    []Generated_Symbol{.s0},
                                ),
                            ),
                            mk.kattr(
                                .out,
                                mk.write_layer_enum(
                                    []Generated_Symbol{.s2},
                                    []Generated_Symbol{.s2},
                                    []Generated_Symbol{.s1},
                                ),
                            ),
                        },
                    ),
                },
            ),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(
                        .in_,
                        mk.match_layer_enum([]Generated_Symbol{.s0, .s0, .s0}, []Generated_Symbol{.s0, .s2, .s0}),
                    ),
                    mk.kattr(
                        .out,
                        mk.write_layer(
                            mk.write_row(mk.keep(), mk.keep(), mk.keep()),
                            mk.write_row(mk.keep(), mk.sym(1), mk.keep()),
                        ),
                    ),
                },
            ),
            mk.node(
                mk.Proc_Tag.markov,
                nil,
                []mk.Proc_Node {
                    mk.node(
                        mk.Proc_Tag.one,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s4, .s2, .s2})),
                            mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s4, .s4, .s4})),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.sequence,
                        nil,
                        []mk.Proc_Node {
                            mk.node(
                                mk.Proc_Tag.one,
                                []mk.Proc_Attr {
                                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s4, .s2, .s3})),
                                    mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s1, .s0, .s2})),
                                },
                            ),
                            mk.node(
                                mk.Proc_Tag.all,
                                []mk.Proc_Attr {
                                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s4})),
                                    mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s2})),
                                },
                            ),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.one,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s1, .s0, .s2})),
                            mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s4, .s2, .s3})),
                        },
                    ),
                },
            ),
        },
    )
}

model_hamiltonianpaths :: proc() -> mk.Proc_Node {
    return mk.node(
        mk.Proc_Tag.sequence,
        []mk.Proc_Attr{mk.kattr(.values, mk.values_count(4)), mk.kattr(.origin, true)},
        []mk.Proc_Node {
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s1, .s0, .s0})),
                    mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s2, .s2, .s1})),
                    mk.kattr(.steps, 1),
                },
            ),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(
                        .in_,
                        mk.match_layer(
                            mk.match_row(mk.one_of(mk.sym(1)), mk.any(), mk.one_of(mk.sym(0))),
                            mk.match_row(mk.any(), mk.any(), mk.any()),
                            mk.match_row(mk.one_of(mk.sym(2)), mk.any(), mk.any()),
                        ),
                    ),
                    mk.kattr(
                        .out,
                        mk.write_layer(
                            mk.write_row(mk.sym(2), mk.sym(2), mk.sym(1)),
                            mk.write_row(mk.keep(), mk.keep(), mk.keep()),
                            mk.write_row(mk.keep(), mk.keep(), mk.keep()),
                        ),
                    ),
                    mk.kattr(.symmetry, mk.symmetry_mask(mk.SYMMETRY_2D_XY_PLUS)),
                },
            ),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(
                        .in_,
                        mk.match_layer_enum([]Generated_Symbol{.s0, .s0, .s0}, []Generated_Symbol{.s0, .s2, .s0}),
                    ),
                    mk.kattr(
                        .out,
                        mk.write_layer(
                            mk.write_row(mk.keep(), mk.keep(), mk.keep()),
                            mk.write_row(mk.keep(), mk.sym(1), mk.keep()),
                        ),
                    ),
                },
            ),
            mk.node(
                mk.Proc_Tag.markov,
                nil,
                []mk.Proc_Node {
                    mk.node(
                        mk.Proc_Tag.all,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s3, .s2, .s2})),
                            mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s2, .s0, .s1})),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.all,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s2, .s0, .s1})),
                            mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s3, .s2, .s2})),
                        },
                    ),
                },
            ),
        },
    )
}

model_hills :: proc() -> mk.Proc_Node {
    return mk.node(
        mk.Proc_Tag.sequence,
        []mk.Proc_Attr{mk.kattr(.values, mk.values_count(2))},
        []mk.Proc_Node {
            mk.node(
                mk.Proc_Tag.prl,
                []mk.Proc_Attr {
                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s0})),
                    mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s1})),
                },
            ),
            mk.node(
                mk.Proc_Tag.prl,
                []mk.Proc_Attr {
                    mk.kattr(
                        .in_,
                        mk.match_layers(
                            mk.match_layer(mk.match_row(mk.any())),
                            mk.match_layer(mk.match_row(mk.one_of(mk.sym(1)))),
                        ),
                    ),
                    mk.kattr(
                        .out,
                        mk.write_layers(
                            mk.write_layer(mk.write_row(mk.keep())),
                            mk.write_layer(mk.write_row(mk.sym(0))),
                        ),
                    ),
                    mk.kattr(.symmetry, mk.symmetry_mask(mk.SYMMETRY_3D_IDENTITY)),
                },
            ),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s1, .s0})),
                    mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s1, .s1})),
                    mk.kattr(.steps, 8000),
                },
            ),
            mk.node(
                mk.Proc_Tag.convolution,
                []mk.Proc_Attr{mk.kattr(.neighborhood, "NoCorners"), mk.kattr(.periodic, true)},
                []mk.Proc_Node {
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.sym(0)),
                            mk.kattr(.out, mk.sym(1)),
                            mk.kattr(.sum, "10..18"),
                            mk.kattr(.values, mk.one_of(mk.sym(1))),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.sym(1)),
                            mk.kattr(.out, mk.sym(0)),
                            mk.kattr(.sum, "10..18"),
                            mk.kattr(.values, mk.one_of(mk.sym(0))),
                        },
                    ),
                },
            ),
        },
    )
}

