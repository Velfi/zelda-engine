                            mk.kattr(
                                .out,
                                mk.write_layer(
                                    mk.write_row(mk.keep(), mk.keep(), mk.keep()),
                                    mk.write_row(mk.keep(), mk.sym(2), mk.keep()),
                                ),
                            ),
                            mk.kattr(.comment, "color river endpoints indigo"),
