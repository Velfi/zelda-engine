model_island :: proc() -> mk.Proc_Node {
    return mk.node(
        mk.Proc_Tag.sequence,
        []mk.Proc_Attr{mk.kattr(.values, mk.values_count(14)), mk.kattr(.origin, true)},
        []mk.Proc_Node {
            mk.node(
                mk.Proc_Tag.prl,
                []mk.Proc_Attr {
                    mk.kattr(
                        .in_,
                        mk.match_layer(
                            mk.match_row(mk.any(), mk.any(), mk.any()),
                            mk.match_row(mk.any(), mk.one_of(mk.sym(0)), mk.any()),
                            mk.match_row(mk.any(), mk.any(), mk.any()),
                        ),
                    ),
                    mk.kattr(
                        .out,
                        mk.write_layer(
                            mk.write_row(mk.keep(), mk.keep(), mk.keep()),
                            mk.write_row(mk.keep(), mk.sym(6), mk.keep()),
                            mk.write_row(mk.keep(), mk.keep(), mk.keep()),
                        ),
                    ),
                },
            ),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s1, .s6})),
                    mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s1, .s1})),
                    mk.kattr(.steps, 1),
                    mk.kattr(.comment, "draw an island skeleton"),
                },
            ),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(
                        .in_,
                        mk.match_layer_enum([]Generated_Symbol{.s6, .s1, .s6}, []Generated_Symbol{.s6, .s6, .s6}),
                    ),
                    mk.kattr(
                        .out,
                        mk.write_layer_enum([]Generated_Symbol{.s6, .s1, .s6}, []Generated_Symbol{.s6, .s1, .s6}),
                    ),
                    mk.kattr(.steps, 400),
                    mk.kattr(.comment, "steps define the lenght of the backbone"),
                },
            ),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(
                        .in_,
                        mk.match_layer_enum(
                            []Generated_Symbol{.s6, .s1, .s6},
                            []Generated_Symbol{.s6, .s1, .s6},
                            []Generated_Symbol{.s6, .s6, .s6},
                        ),
                    ),
                    mk.kattr(
                        .out,
                        mk.write_layer_enum(
                            []Generated_Symbol{.s6, .s1, .s6},
                            []Generated_Symbol{.s6, .s3, .s6},
                            []Generated_Symbol{.s6, .s6, .s6},
                        ),
                    ),
                },
            ),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(
                        .in_,
                        mk.match_layer_enum([]Generated_Symbol{.s6, .s6, .s6}, []Generated_Symbol{.s1, .s1, .s1}),
                    ),
                    mk.kattr(
                        .out,
                        mk.write_layer_enum([]Generated_Symbol{.s6, .s1, .s6}, []Generated_Symbol{.s1, .s1, .s1}),
                    ),
                    mk.kattr(.steps, 20),
                    mk.kattr(
                        .comment,
                        "adjust steps to change number of branches. More branches = rounder, smoother island with less inner water",
                    ),
                },
            ),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(
                        .in_,
                        mk.match_layer_enum([]Generated_Symbol{.s6, .s1, .s6}, []Generated_Symbol{.s6, .s6, .s6}),
                    ),
                    mk.kattr(
                        .out,
                        mk.write_layer_enum([]Generated_Symbol{.s6, .s1, .s6}, []Generated_Symbol{.s6, .s1, .s6}),
                    ),
                    mk.kattr(.steps, 2300),
                    mk.kattr(.comment, "adjust steps for the length of branches. More lenght = bigger island"),
                },
            ),
            mk.node(
                mk.Proc_Tag.all,
                []mk.Proc_Attr {
                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s3})),
                    mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s1})),
                },
            ),
            mk.node(
                mk.Proc_Tag.prl,
                []mk.Proc_Attr {
                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s6})),
                    mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s0})),
                    mk.kattr(.p, 0.00003),
                    mk.kattr(.steps, 1),
                    mk.kattr(.comment, "adjust p to reduce lakes"),
                },
            ),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr{mk.kattr(.comment, "Voronoi")},
                []mk.Proc_Node {
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s1, .s6})),
                            mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s1, .s1})),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s0, .s6})),
                            mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s0, .s0})),
                        },
                    ),
                },
            ),
            mk.node(
                mk.Proc_Tag.convolution,
                []mk.Proc_Attr{mk.kattr(.neighborhood, "Moore"), mk.kattr(.comment, "smoothing")},
                []mk.Proc_Node {
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.sym(0)),
                            mk.kattr(.out, mk.sym(1)),
                            mk.kattr(.sum, "5..8"),
                            mk.kattr(.values, mk.one_of(mk.sym(1))),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.sym(1)),
                            mk.kattr(.out, mk.sym(0)),
                            mk.kattr(.sum, "5..8"),
                            mk.kattr(.values, mk.one_of(mk.sym(0))),
                        },
                    ),
                },
            ),
            mk.node(
                mk.Proc_Tag.all,
                []mk.Proc_Attr {
                    mk.kattr(.in_, mk.match_layer(mk.match_row(mk.one_of(mk.sym(0))), mk.match_row(mk.any()))),
                    mk.kattr(.out, mk.write_layer(mk.write_row(mk.sym(7)), mk.write_row(mk.keep()))),
                    mk.kattr(.symmetry, mk.symmetry_mask(mk.SYMMETRY_2D_X)),
                    mk.kattr(.comment, "paint ocean to find out coasts. Sea will be U, lakes I, deep ocean B"),
                },
            ),
            mk.node(
                mk.Proc_Tag.all,
                []mk.Proc_Attr {
                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s0, .s7})),
                    mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s0, .s0})),
                },
            ),
            mk.node(
                mk.Proc_Tag.all,
                []mk.Proc_Attr {
                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s1, .s0})),
                    mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s1, .s3})),
                },
            ),
            mk.node(
                mk.Proc_Tag.prl,
                []mk.Proc_Attr {
                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s3, .s0})),
                    mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s3, .s3})),
                    mk.kattr(.steps, 30),
                    mk.kattr(.p, 0.5),
                    mk.kattr(.comment, "steps = size of the shallow water around the coast"),
                },
            ),
            mk.node(
                mk.Proc_Tag.prl,
                []mk.Proc_Attr {
                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s0})),
                    mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s2})),
                },
            ),
            mk.node(
                mk.Proc_Tag.prl,
                []mk.Proc_Attr {
                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s3})),
                    mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s0})),
                },
            ),
            mk.node(
                mk.Proc_Tag.all,
                []mk.Proc_Attr {
                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s0, .s1})),
                    mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s0, .s4})),
                    mk.kattr(
                        .comment,
                        "spawn a few river sources (paint coast green on some thickness to force sources to be inland)",
                    ),
                },
            ),
            mk.node(
