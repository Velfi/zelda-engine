model_selectlargecaves :: proc() -> mk.Proc_Node {
    return mk.node(
        mk.Proc_Tag.sequence,
        []mk.Proc_Attr{mk.kattr(.values, mk.values_count(4))},
        []mk.Proc_Node {
            mk.node(
                mk.Proc_Tag.prl,
                []mk.Proc_Attr {
                    mk.kattr(
                        .in_,
                        mk.match_layer(
                            mk.match_row(mk.any(), mk.any(), mk.any()),
                            mk.match_row(mk.any(), mk.one_of(mk.sym(0)), mk.any()),
                            mk.match_row(mk.any(), mk.any(), mk.any()),
                        ),
                    ),
                    mk.kattr(
                        .out,
                        mk.write_layer(
                            mk.write_row(mk.keep(), mk.keep(), mk.keep()),
                            mk.write_row(mk.keep(), mk.sym(1), mk.keep()),
                            mk.write_row(mk.keep(), mk.keep(), mk.keep()),
                        ),
                    ),
                },
            ),
            mk.node(
                mk.Proc_Tag.prl,
                []mk.Proc_Attr {
                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s1})),
                    mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s0})),
                    mk.kattr(.p, 0.435),
                    mk.kattr(.steps, 1),
                },
            ),
            mk.node(
                mk.Proc_Tag.convolution,
                []mk.Proc_Attr{mk.kattr(.neighborhood, "Moore")},
                []mk.Proc_Node {
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.sym(1)),
                            mk.kattr(.out, mk.sym(0)),
                            mk.kattr(.sum, "5..8"),
                            mk.kattr(.values, mk.one_of(mk.sym(0))),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.sym(0)),
