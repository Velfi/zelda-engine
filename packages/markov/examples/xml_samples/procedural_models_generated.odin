                    ),
                    mk.node(
                        mk.Proc_Tag.all,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s2, .s1})),
                            mk.kattr(.out, mk.write_layer(mk.write_row(mk.keep(), mk.sym(2)))),
                            mk.kattr(.comment, "color the whole path indigo"),
