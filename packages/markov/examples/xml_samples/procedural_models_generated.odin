                mk.Proc_Tag.all,
                nil,
                []mk.Proc_Node {
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s1, .s0, .s0})),
                            mk.kattr(.out, mk.write_layer(mk.write_row(mk.keep(), mk.keep(), mk.sym(2)))),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s2, .s0, .s0})),
                            mk.kattr(.out, mk.write_layer(mk.write_row(mk.keep(), mk.keep(), mk.sym(2)))),
                        },
                    ),
                },
            ),
            mk.node(
                mk.Proc_Tag.markov,
                nil,
                []mk.Proc_Node {
                    mk.node(
                        mk.Proc_Tag.one,
                        nil,
                        []mk.Proc_Node {
                            mk.node(
                                mk.Proc_Tag.rule,
                                []mk.Proc_Attr {
                                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s3, .s0, .s2})),
                                    mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s4, .s4, .s3})),
                                },
                            ),
                            mk.node(
                                mk.Proc_Tag.rule,
                                []mk.Proc_Attr {
                                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s3, .s0, .s4})),
                                    mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s5, .s4, .s6})),
                                },
                            ),
                            mk.node(
                                mk.Proc_Tag.rule,
                                []mk.Proc_Attr {
                                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s3, .s0, .s1})),
                                    mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s1, .s1, .s1})),
                                },
                            ),
                            mk.node(
                                mk.Proc_Tag.rule,
                                []mk.Proc_Attr {
                                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s1, .s4, .s4})),
                                    mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s1, .s1, .s1})),
                                },
                            ),
                            mk.node(
                                mk.Proc_Tag.rule,
                                []mk.Proc_Attr {
                                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s6, .s4, .s5})),
                                    mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s6, .s0, .s7})),
                                },
                            ),
                            mk.node(
                                mk.Proc_Tag.rule,
                                []mk.Proc_Attr {
                                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s7, .s4, .s4})),
                                    mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s2, .s0, .s7})),
                                },
                            ),
                            mk.node(
                                mk.Proc_Tag.rule,
                                []mk.Proc_Attr {
                                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s7, .s4, .s6})),
                                    mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s2, .s0, .s3})),
                                },
                            ),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.one,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s2})),
                            mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s3})),
                        },
                    ),
                },
            ),
        },
    )
}

model_wolfbasedapproach :: proc() -> mk.Proc_Node {
    return mk.node(
        mk.Proc_Tag.sequence,
        []mk.Proc_Attr{mk.kattr(.values, mk.values_count(7))},
        []mk.Proc_Node {
            mk.node(
                mk.Proc_Tag.prl,
                []mk.Proc_Attr {
                    mk.kattr(
                        .in_,
                        mk.match_layer(
                            mk.match_row(mk.any(), mk.any(), mk.any()),
                            mk.match_row(mk.any(), mk.one_of(mk.sym(0)), mk.any()),
                            mk.match_row(mk.any(), mk.any(), mk.any()),
                        ),
                    ),
                    mk.kattr(
                        .out,
                        mk.write_layer(
                            mk.write_row(mk.keep(), mk.keep(), mk.keep()),
                            mk.write_row(mk.keep(), mk.sym(1), mk.keep()),
                            mk.write_row(mk.keep(), mk.keep(), mk.keep()),
                        ),
                    ),
                },
            ),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s1})),
                    mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s3})),
                    mk.kattr(.steps, 15),
                },
            ),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s1})),
                    mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s4})),
                    mk.kattr(.steps, 1),
                },
            ),
            mk.node(
                mk.Proc_Tag.all,
                nil,
                []mk.Proc_Node {
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s4, .s2})),
                            mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s2, .s4})),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s4, .s1})),
                            mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s5, .s4})),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s3, .s2})),
                            mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s2, .s3})),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s3, .s1})),
                            mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s2, .s3})),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s4, .s3})),
                            mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s4, .s4})),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(
                                .in_,
                                mk.match_layer(
                                    mk.match_row(mk.one_of(mk.sym(4)), mk.any()),
                                    mk.match_row(mk.any(), mk.one_of(mk.sym(3))),
                                ),
                            ),
                            mk.kattr(
                                .out,
                                mk.write_layer(mk.write_row(mk.sym(4), mk.keep()), mk.write_row(mk.keep(), mk.sym(4))),
                            ),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.field,
                        []mk.Proc_Attr {
                            mk.kattr(.for_, mk.sym(3)),
                            mk.kattr(.to, mk.one_of(mk.sym(1))),
                            mk.kattr(.on, mk.one_of(mk.sym(2))),
                            mk.kattr(.recompute, true),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.field,
                        []mk.Proc_Attr {
                            mk.kattr(.for_, mk.sym(4)),
                            mk.kattr(.to, mk.one_of(mk.sym(3))),
                            mk.kattr(.on, mk.one_of(mk.sym(1), mk.sym(2))),
                            mk.kattr(.recompute, true),
                            mk.kattr(.essential, true),
                        },
                    ),
                },
            ),
            mk.node(
                mk.Proc_Tag.prl,
                nil,
                []mk.Proc_Node {
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s1})),
                            mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s0})),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s5})),
                            mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s6})),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s4})),
                            mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s6})),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s2})),
                            mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s6})),
                        },
                    ),
                },
            ),
            mk.node(
                mk.Proc_Tag.all,
                nil,
                []mk.Proc_Node {
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(
                                .in_,
                                mk.match_layer_enum([]Generated_Symbol{.s0, .s6}, []Generated_Symbol{.s6, .s0}),
                            ),
                            mk.kattr(
                                .out,
                                mk.write_layer(mk.write_row(mk.keep(), mk.keep()), mk.write_row(mk.keep(), mk.sym(6))),
                            ),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(
                                .in_,
                                mk.match_layer_enum(
                                    []Generated_Symbol{.s6, .s6, .s6},
                                    []Generated_Symbol{.s6, .s0, .s6},
                                    []Generated_Symbol{.s6, .s6, .s6},
                                ),
                            ),
                            mk.kattr(
                                .out,
                                mk.write_layer(
                                    mk.write_row(mk.keep(), mk.keep(), mk.keep()),
                                    mk.write_row(mk.keep(), mk.sym(6), mk.keep()),
                                    mk.write_row(mk.keep(), mk.keep(), mk.keep()),
                                ),
                            ),
                        },
                    ),
                },
            ),
            mk.node(
                mk.Proc_Tag.all,
                []mk.Proc_Attr {
                    mk.kattr(
                        .in_,
                        mk.match_layer_enum([]Generated_Symbol{.s0, .s0, .s0}, []Generated_Symbol{.s0, .s6, .s0}),
                    ),
                    mk.kattr(
                        .out,
                        mk.write_layer(
                            mk.write_row(mk.keep(), mk.keep(), mk.keep()),
                            mk.write_row(mk.keep(), mk.sym(0), mk.keep()),
                        ),
                    ),
                },
            ),
        },
    )
}

