}

model_nystromdungeon :: proc() -> mk.Proc_Node {
    return mk.node(
        mk.Proc_Tag.sequence,
        []mk.Proc_Attr{mk.kattr(.values, mk.values_count(5)), mk.kattr(.origin, true)},
        []mk.Proc_Node {
            mk.node(
                mk.Proc_Tag.all,
                []mk.Proc_Attr {
                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s1, .s0, .s0})),
                    mk.kattr(.out, mk.write_layer(mk.write_row(mk.keep(), mk.keep(), mk.sym(1)))),
                    mk.kattr(.comment, "draw a grid"),
                },
            ),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(
                        .in_,
                        mk.match_layer_enum(
                            []Generated_Symbol{.s1, .s0, .s1, .s0, .s1, .s0, .s1, .s0, .s1},
                            []Generated_Symbol{.s0, .s0, .s0, .s0, .s0, .s0, .s0, .s0, .s0},
                            []Generated_Symbol{.s1, .s0, .s1, .s0, .s1, .s0, .s1, .s0, .s1},
                            []Generated_Symbol{.s0, .s0, .s0, .s0, .s0, .s0, .s0, .s0, .s0},
                            []Generated_Symbol{.s1, .s0, .s1, .s0, .s1, .s0, .s1, .s0, .s1},
                            []Generated_Symbol{.s0, .s0, .s0, .s0, .s0, .s0, .s0, .s0, .s0},
                            []Generated_Symbol{.s1, .s0, .s1, .s0, .s1, .s0, .s1, .s0, .s1},
                        ),
                    ),
                    mk.kattr(
                        .out,
                        mk.write_layer_enum(
                            []Generated_Symbol{.s2, .s2, .s2, .s2, .s2, .s2, .s2, .s2, .s2},
                            []Generated_Symbol{.s2, .s2, .s2, .s2, .s2, .s2, .s2, .s2, .s2},
                            []Generated_Symbol{.s2, .s2, .s2, .s2, .s2, .s2, .s2, .s2, .s2},
                            []Generated_Symbol{.s2, .s2, .s2, .s2, .s2, .s2, .s2, .s2, .s2},
                            []Generated_Symbol{.s2, .s2, .s2, .s2, .s2, .s2, .s2, .s2, .s2},
                            []Generated_Symbol{.s2, .s2, .s2, .s2, .s2, .s2, .s2, .s2, .s2},
                            []Generated_Symbol{.s2, .s2, .s2, .s2, .s2, .s2, .s2, .s2, .s2},
                        ),
                    ),
                },
            ),
            mk.node(
                mk.Proc_Tag.markov,
                []mk.Proc_Attr{mk.kattr(.comment, "generate corridors with MazeBacktracker")},
                []mk.Proc_Node {
                    mk.node(
                        mk.Proc_Tag.one,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s3, .s0, .s1})),
                            mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s4, .s4, .s3})),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.one,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s4, .s4, .s3})),
                            mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s3, .s2, .s2})),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.one,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s1})),
                            mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s3})),
                        },
                    ),
                },
            ),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s3})),
                    mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s4})),
                    mk.kattr(.steps, 1),
                    mk.kattr(.comment, "leave only one start"),
                },
            ),
            mk.node(
                mk.Proc_Tag.all,
                []mk.Proc_Attr {
                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s3})),
                    mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s2})),
                    mk.kattr(.comment, "forget other starts"),
                },
            ),
            mk.node(
                mk.Proc_Tag.markov,
                []mk.Proc_Attr{mk.kattr(.comment, "connect components")},
                []mk.Proc_Node {
                    mk.node(
                        mk.Proc_Tag.all,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s4, .s2, .s2})),
                            mk.kattr(.out, mk.write_layer(mk.write_row(mk.keep(), mk.keep(), mk.sym(4)))),
                        },
                    ),
                    mk.node(
                        mk.Proc_Tag.one,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s4, .s0, .s2})),
                            mk.kattr(.out, mk.write_layer(mk.write_row(mk.keep(), mk.sym(2), mk.sym(4)))),
                        },
                    ),
                },
            ),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s4, .s0, .s4})),
                    mk.kattr(.out, mk.write_layer(mk.write_row(mk.keep(), mk.sym(2), mk.keep()))),
                    mk.kattr(.steps, 5),
                    mk.kattr(.comment, "insert cycles"),
                },
            ),
            mk.node(
                mk.Proc_Tag.all,
                []mk.Proc_Attr {
                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s4})),
                    mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s2})),
                    mk.kattr(.comment, "forget structure"),
                },
            ),
            mk.node(
                mk.Proc_Tag.all,
                []mk.Proc_Attr {
                    mk.kattr(
                        .in_,
                        mk.match_layer_enum([]Generated_Symbol{.s0, .s0, .s0}, []Generated_Symbol{.s0, .s2, .s0}),
                    ),
                    mk.kattr(
                        .out,
                        mk.write_layer_enum([]Generated_Symbol{.s0, .s0, .s0}, []Generated_Symbol{.s0, .s0, .s0}),
                    ),
                    mk.kattr(.comment, "retract dead ends"),
                },
            ),
        },
    )
}

model_oddscale :: proc() -> mk.Proc_Node {
    return mk.node(
        mk.Proc_Tag.sequence,
        []mk.Proc_Attr {
            mk.kattr(.values, mk.values_count(2)),
            mk.kattr(.symmetry, mk.symmetry_mask(mk.SYMMETRY_2D_IDENTITY)),
        },
        []mk.Proc_Node {
            mk.node(
                mk.Proc_Tag.prl,
                []mk.Proc_Attr {
                    mk.kattr(
                        .in_,
                        mk.match_layer(
                            mk.match_row(mk.any(), mk.any(), mk.any()),
                            mk.match_row(mk.any(), mk.one_of(mk.sym(0)), mk.any()),
                            mk.match_row(mk.any(), mk.any(), mk.any()),
                        ),
                    ),
                    mk.kattr(
                        .out,
                        mk.write_layer(
                            mk.write_row(mk.keep(), mk.keep(), mk.keep()),
                            mk.write_row(mk.keep(), mk.sym(1), mk.keep()),
                            mk.write_row(mk.keep(), mk.keep(), mk.keep()),
                        ),
                    ),
                },
            ),
            mk.node(
                mk.Proc_Tag.prl,
                []mk.Proc_Attr {
                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s1})),
                    mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s0})),
                    mk.kattr(.p, 0.5),
                    mk.kattr(.steps, 1),
                },
            ),
            mk.node(
                mk.Proc_Tag.map_,
                []mk.Proc_Attr{mk.kattr(.scale, "2 2 1"), mk.kattr(.values, mk.values_count(3))},
                []mk.Proc_Node {
                    mk.node(
                        mk.Proc_Tag.rule,
                        []mk.Proc_Attr {
                            mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s1})),
                            mk.kattr(
                                .out,
                                mk.write_layer_enum(
                                    []Generated_Symbol{.s1, .s2, .s1},
                                    []Generated_Symbol{.s2, .s2, .s2},
                                    []Generated_Symbol{.s1, .s2, .s1},
                                ),
                            ),
                        },
                    ),
                },
            ),
        },
    )
}

