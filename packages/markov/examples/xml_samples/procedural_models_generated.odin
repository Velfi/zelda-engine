model_nodeadends :: proc() -> mk.Proc_Node {
    return mk.node(
        mk.Proc_Tag.markov,
        []mk.Proc_Attr{mk.kattr(.values, mk.values_count(4)), mk.kattr(.origin, true)},
        []mk.Proc_Node {
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s1, .s0, .s0})),
                    mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s2, .s3, .s1})),
                },
            ),
            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s2, .s0, .s0})),
                    mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s2, .s3, .s1})),
                },
            ),
            mk.node(
                mk.Proc_Tag.all,
                []mk.Proc_Attr {
                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s1, .s0, .s1})),
                    mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s2, .s3, .s2})),
                },
            ),
            mk.node(
                mk.Proc_Tag.all,
                []mk.Proc_Attr {
                    mk.kattr(.in_, mk.match_layer_enum([]Generated_Symbol{.s1, .s0, .s2})),
                    mk.kattr(.out, mk.write_layer_enum([]Generated_Symbol{.s2, .s3, .s2})),
                },
            ),
        },
    )
}

model_noise :: proc() -> mk.Proc_Node {
