                        []mk.Proc_Attr{mk.kattr(.in_, mk.sym(1)), mk.kattr(.out, "Empty|Line|Turn")},
                    ),
                    mk.node(mk.Proc_Tag.rule, []mk.Proc_Attr{mk.kattr(.in_, mk.sym(2)), mk.kattr(.out, "End")}),
                    mk.node(
                        mk.Proc_Tag.one,
                        []mk.Proc_Attr {
