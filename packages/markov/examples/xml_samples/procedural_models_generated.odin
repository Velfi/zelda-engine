            mk.node(
                mk.Proc_Tag.one,
                []mk.Proc_Attr {
                    mk.kattr(
                        .in_,
                        mk.match_layer_enum(
                            []Generated_Symbol{.s1, .s1, .s0},
                            []Generated_Symbol{.s1, .s1, .s0},
                            []Generated_Symbol{.s0, .s0, .s0},
                        ),
                    ),
                    mk.kattr(
                        .out,
                        mk.write_layer(
                            mk.write_row(mk.sym(2), mk.keep(), mk.keep()),
                            mk.write_row(mk.keep(), mk.keep(), mk.keep()),
                            mk.write_row(mk.keep(), mk.keep(), mk.keep()),
                        ),
                    ),
                    mk.kattr(.symmetry, mk.symmetry_mask(mk.SYMMETRY_2D_IDENTITY)),
